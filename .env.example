# Store these in GitHub Actions repository secrets. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
# Explicit operational enablement after retention and API-access review.
EIIM_ENABLE_LIVE=false

# Optional existing-caption provider; no account or subscription is created by code.
SUPADATA_API_KEY=
# Calendar-month cap shared across batches; default matches the free trial tier.
EIIM_CAPTION_MONTHLY_REQUEST_LIMIT=100
